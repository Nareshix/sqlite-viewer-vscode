{
  "name": "monaco-hello",
  "displayName": "monaco-hello",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],

"activationEvents": [
  "onLanguage:sqlite",
  "workspaceContains:**/*.db",
  "workspaceContains:**/*.sqlite"
],
  "main": "./dist/extension.js",
"contributes": {
  "customEditors": [
    {
      "viewType": "monaco-hello.sqliteEditor",
      "displayName": "Monaco SQLite Editor",
      "selector": [
        { "filenamePattern": "*.db" },
        { "filenamePattern": "*.sqlite" }
      ],
      "priority": "default"
    }
  ]
},
  "scripts": {
"build": "cd backend && napi build --platform --release && cd .. && vite build && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.3",
    "fs-extra": "^11.3.5",
    "npm-run-all": "^4.1.5",
    "svelte": "^5.55.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "monaco-editor": "^0.43.0"
  }
}
