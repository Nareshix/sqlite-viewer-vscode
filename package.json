{
  "name": "monaco-hello",
  "displayName": "monaco-hello",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "monaco-hello.open",
        "title": "Open Monaco Editor"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "vite build",
    "build:ext": "node esbuild.js",
    "build": "npm run build:webview && npm run build:ext",
    "dev": "npm run build:webview && node esbuild.js --watch"
  }
,  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.3",
    "fs-extra": "^11.3.5",
    "npm-run-all": "^4.1.5",
    "svelte": "^5.55.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "monaco-editor": "^0.43.0"
  }
}
